<fieldset>
    <legend>{{ localize "DND5E.ADVANCEMENT.Trait.Details" }}</legend>
    {{ formField configuration.fields.mode name="configuration.mode" value=configuration.data.mode
                 hint=mode.hint options=mode.options rootId=partId }}
    {{ formField configuration.fields.allowReplacements name="configuration.allowReplacements"
                 value=configuration.data.allowReplacements input=inputs.createCheckboxInput
                 disabled=disableAllowReplacements rootId=partId }}

    <div class="form-group dndestiny-special-trait-proficiency-group">
        <label>Special Trait Proficiency</label>
        <div class="form-fields">
            <dndestiny-checkbox class="dndestiny-special-trait-proficiency-checkbox"></dndestiny-checkbox>
        </div>
        <p class="hint">Use this to add text next to a skill. used for Bladedancers Trick of the Trade</p>
    </div>
    <div class="form-group dndestiny-special-trait-proficiency-text-group" hidden>
        <label>Addon Text</label>
        <div class="form-fields">
            <input type="text" class="dndestiny-special-trait-proficiency-text">
        </div>
    </div>
</fieldset>
