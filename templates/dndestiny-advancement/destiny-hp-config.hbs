<fieldset>
    <legend>Destiny Hit Points</legend>
    <div class="form-group">
        <label>Base Hit Points (1st Level)</label>
        <div class="form-fields">
            <input type="number" name="configuration.baseHitPoints" value="{{ configuration.data.baseHitPoints }}" min="0" step="1">
        </div>
        <p class="hint">Added to the Constitution modifier at 1st level. Every level after that adds the
            Constitution modifier again (minimum 0).</p>
    </div>
</fieldset>
