<div class="chat-card bastion-card">

    {{!-- Description --}}
    <p class="order-description">{{{ description }}}</p>

    {{!-- Damaged --}}
    {{#if damaged}}
    <p class="order-description">{{{ damaged }}}</p>
    {{/if}}

    {{!-- Roll --}}
    {{{ roll }}}

    {{!-- Buttons --}}
    {{> "dndestiny.card-buttons" }}

</div>

{{!-- Rolls --}}
{{> "dndestiny.card-rolls" }}
