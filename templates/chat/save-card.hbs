<div class="chat-card{{#if death}} death-save{{/if}}">

    {{!-- Header --}}
    {{> "dndestiny.card-header" }}

    {{!-- Supplements --}}
    {{#if outcome}}
    <p class="supplement">{{ outcome }}</p>
    {{/if}}

    {{#if resisted}}
    <p class="supplement">
        <strong>{{ localize "DND5E.ROLL.Status" }}</strong>
        {{ localize "DND5E.LegendaryResistance.Resisted" }}
    </p>
    {{/if}}

    {{#if concentrationBroken}}
    <p class="supplement">
        <strong>{{ localize "DND5E.ROLL.Status" }}</strong>
        {{ localize "DND5E.CONCENTRATION.Lost" }}
    </p>
    {{/if}}

    {{!-- Rows --}}
    {{> "dndestiny.card-rows" }}

    {{!-- Buttons --}}
    {{> "dndestiny.card-buttons" }}

</div>

{{!-- Rolls --}}
{{> "dndestiny.card-rolls" }}

{{!-- Deltas --}}
{{#if deltas.length}}
{{> "dndestiny.card-deltas" }}
{{/if}}
